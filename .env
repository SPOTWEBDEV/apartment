# Copy this file to ".env" and fill in your own values. NEVER commit or share the real .env.
# Best place for the real file: one folder ABOVE the website folder (outside the web root).

APP_ENV=local            # production or local
APP_DEBUG=false               # true shows PHP errors on screen (local development only)
APP_URL=http://localhost/apartment   # public address of the website, no trailing slash (used in emails)

# First admin account. Used only when the database is created (or by: php tools/create-admin.php).
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin@admin.com               # at least 10 characters; change it again after your first login

# Optional: keep the database outside the web root. Relative paths start from the project folder.
DB_PATH=

# Email. Leave MAIL_HOST empty to fall back to PHP mail() (often blocked on shared hosting).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls           # tls (port 587), ssl (port 465) or none
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
